{
  "id": "mapcanvas",
  "name": "栅图 MapCanvas",
  "version": "0.2.1",
  "main": "index.js",
  "description": "ROS栅格地图编辑：可收起路径、灰色画笔、AI预览/试画/编辑提案与使用指南。",
  "workbench": {
    "protocol": 1,
    "entry": "workbench.html",
    "title": "栅图 MapCanvas",
    "tools": [
      "mapcanvas_help",
      "mapcanvas_preview",
      "mapcanvas_edit",
      "mapcanvas_sources",
      "mapcanvas_browse",
      "mapcanvas_read"
    ],
    "fileHandler": {
      "extensions": [
        ".pgm",
        ".png"
      ],
      "priority": -100,
      "editable": true
    }
  },
  "author": "skyelan1999",
  "license": "MIT"
}
